# Base URL of the Admin Application BFF (no path prefix — routes are /reps, not /api/reps)
VITE_API_BASE_URL=http://localhost:3000

# Keycloak realm/client are NOT env vars anymore — they're resolved per-request from the
# hostname via public/tenant-registry.json (see src/tenant/resolveTenant.ts and
# spec/tenant-domains-and-hipaa-isolation-team-brief.md §5). Edit that JSON file to add or
# change tenants/realms; there's nothing to set here for Keycloak.

# How long (seconds) this tab's in-memory copy of the tenant manifest is considered fresh before
# a re-fetch. One of three independently configurable cache layers over the same manifest — see
# docs/aws-api-gateway-lambda-authorizer.md §9. Optional; defaults to 300 if unset.
VITE_TENANT_MANIFEST_TTL_SECONDS=300

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "coordinator",
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Bash(rm -rf /:*)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Edit(**/package.json)",
      "Write(**/package.json)",
      "Edit(**/.github/workflows/**)",
      "Write(**/.github/workflows/**)",
      "Edit(project.config.yml)",
      "Write(project.config.yml)",
      "Edit(project.config.schema.json)",
      "Write(project.config.schema.json)"
    ],
    "allow": [
      "Edit(src/**)",
      "Write(src/**)",
      "Bash(git add:*)",
      "Bash(git checkout -b:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/validate-config.mjs\" --config \"$CLAUDE_PROJECT_DIR/project.config.yml\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-loop.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-loop.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-loop.sh\""
          }
        ]
      }
    ]
  },
  "$ai_sdlc_framework_managed": true
}
